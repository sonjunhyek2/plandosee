# apps/web: 공개 값이며 GitHub Pages 빌드 시 브라우저 번들에 포함됩니다.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_BUILD_SHA="local"

# apps/api: Vercel API 서버에만 설정합니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
DATABASE_URL="postgresql://USER:PASSWORD@PRODUCTION-POOLER-HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@PRODUCTION-DIRECT-HOST/DB?sslmode=require"
PDS_DB_ENV="production"
ALLOWED_ORIGINS="https://YOUR_GITHUB_ID.github.io,http://localhost:3000"

# 전용 테스트 DB에서 통합 검증할 때만 설정합니다.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST-POOLER-HOST/TEST_DB?sslmode=require"
PDS_TEST_DB_HOST="TEST-POOLER-HOST"
PDS_TEST_DB_NAME="TEST_DB"

# 전체 테스트 DB 초기화 시에만 임시로 설정하고 실행 직후 제거합니다.
# PDS_TEST_RESET_CONFIRM="RESET_plandosee_TEST_ONLY"
